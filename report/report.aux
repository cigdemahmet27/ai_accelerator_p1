\@writefile{toc}{\contentsline {subsection}{\numberline {6.1}Reconstruction Quality}{8}{subsection.6.1}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces Original Images (Top) vs. Reconstructed Images (Bottom) at latent\_dim = 16. Despite compressing each 784-dimensional image into only 16 values, the reconstructions preserve the overall digit shape and stroke structure. Minor blurring is visible, which is expected given the aggressive 49$\times $ compression ratio.}}{8}{figure.2}\protected@file@percent }
\newlabel{fig:reconstruction}{{2}{8}{Original Images (Top) vs. Reconstructed Images (Bottom) at latent\_dim = 16. Despite compressing each 784-dimensional image into only 16 values, the reconstructions preserve the overall digit shape and stroke structure. Minor blurring is visible, which is expected given the aggressive 49$\times $ compression ratio}{figure.2}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {6.2}Latent Space Projections}{8}{subsection.6.2}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces PCA Projection — global structure is preserved but clusters overlap due to the linear nature of PCA.}}{9}{figure.3}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces t-SNE Projection — non-linear optimization produces tighter, more separated clusters, revealing the true grouping quality of the latent space.}}{9}{figure.4}\protected@file@percent }
